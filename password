a = input("Enter your password: ")

up = 0
sm = 0
sp = 0
dg = 0

if len(a) > 7:
    for i in a:
        if i.isupper():
            up = up + 1
        elif i.islower():
            sm = sm + 1
        elif i.isdigit():
            dg = dg + 1
        else:
            sp = sp + 1

    print("Uppercase letters:", up)
    print("Lowercase letters:", sm)
    print("Digits:", dg)
    print("Special characters:", sp)

    if up > 0 and sm > 0 and dg > 0 and sp > 0:
        print("Password is valid")
    else:
        print("Password is not strong enough")
else:
    print("Password is not valid (must be at least 8 characters)")
